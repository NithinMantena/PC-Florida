# Copy to .env (never commit .env) and fill in.

# Shared secret required on every request except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLPC_API_KEY=change-me

# Public HTTPS base URL (advertised in /openapi.json for ChatGPT Custom GPTs), e.g.
#   https://myserver.tailnet-name.ts.net:8443   (host Tailscale funnel)
#   https://pc-florida.tailnet-name.ts.net      (docker-compose.tailscale.yml)
FLPC_PUBLIC_URL=

# Host folder mounted at /data: drop new quarterly .xlsx files here.
FLPC_DATA_DIR=./incoming

# docker-compose.yml only: host interface/port to publish on.
# 127.0.0.1 = only this machine (Tailscale funnel on the host proxies to it).
FLPC_BIND=127.0.0.1
FLPC_HOST_PORT=8000

# docker-compose.tailscale.yml only.
TS_AUTHKEY=
TS_HOSTNAME=pc-florida
